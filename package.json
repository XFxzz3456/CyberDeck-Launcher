{
  "name": "cyberdeck-launcher",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "A focused Cyberpunk 2077 mod launcher built with Tauri + React",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "release": "node scripts/release.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:list": "node scripts/check-i18n.mjs --list",
    "i18n:gate": "node scripts/check-i18n.mjs --fail",
    "i18n:unused": "node scripts/check-i18n.mjs --unused",
    "i18n:merge": "node scripts/merge-i18n-parts.mjs",
    "test:ui": "node scripts/ui-test.mjs && node scripts/ui-polish-test.mjs && node scripts/ui-theme-test.mjs && node scripts/ui-hardware-test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
